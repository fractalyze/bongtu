{
  "name": "@bongtu/indexer",
  "version": "0.0.0",
  "description": "bongtu indexer \u2014 BongtuPool event ingest, SDK-ImtTree mirror (root == on-chain root), merkle-path + ciphertext-feed API, disclosureHash verify (SPEC \u00a76b)",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "exports": {
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@bongtu/core": "*",
    "pg": "^8.22.0",
    "viem": "^2.55.10"
  },
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "test": "bash test/run.sh",
    "test:tree": "node --import tsx test/tree.test.ts",
    "test:disclosure": "node --import tsx test/disclosure.test.ts",
    "test:ingest": "node --import tsx test/ingest.test.ts",
    "test:projection": "node --import tsx --test test/projection.test.ts",
    "test:config": "node --import tsx test/config.test.ts",
    "test:viewtoken": "node --import tsx --test test/viewtoken.test.ts",
    "test:names": "node --import tsx --test test/names.test.ts",
    "test:announcements": "node --import tsx --test test/announcements.test.ts",
    "test:derivehistory": "node --import tsx --test test/deriveHistory.test.ts",
    "test:history": "node --import tsx --test test/history.test.ts",
    "test:consumer": "node --import tsx test/consumer.test.ts",
    "test:solana": "node --import tsx test/solana.test.ts",
    "test:alarms": "node --import tsx --test test/alarms.test.ts",
    "test:persist": "node --import tsx --test test/persist.test.ts",
    "test:unit": "npm run test:tree && npm run test:disclosure && npm run test:alarms && npm run test:ingest && npm run test:projection && npm run test:consumer && npm run test:config && npm run test:viewtoken && npm run test:names && npm run test:announcements && npm run test:portal && npm run test:derivehistory && npm run test:history && npm run test:persist",
    "test:pg": "bash test/pg_integration.sh",
    "typecheck": "tsc --noEmit",
    "test:portal": "node --import tsx --test test/portal.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
