{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  // Skip every non-production build: PRs get no preview deployments (owner decision
  // 2026-09-06); only pushes to main (VERCEL_ENV=production) build and deploy.
  "ignoreCommand": "[ \"$VERCEL_ENV\" != \"production\" ]",
  "rewrites": [
    {
      "source": "/indexer/:path*",
      "destination": "https://gpu-server.tailec11d1.ts.net:10000/:path*"
    },
    {
      "source": "/prover/:path*",
      "destination": "https://gpu-server.tailec11d1.ts.net:10000/prover/:path*"
    }
  ]
}
