{
  "name": "@bongtu/client",
  "version": "0.0.0",
  "description": "bongtu client engine — the React-free, wagmi-free protocol layer both apps drive: key derivation + the in-memory KeyCache lock, login/session/key-binding, witness assembly (spend/deposit), the prove+submit flow orchestrations, viem submits over a `Connection`, indexer reads and refresh policy, and the kKRW money edge. App config (pool, token, explorer, prover) is threaded in through each flow's ctx/deps seam — this package reads no env and imports no app config.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "exports": {
    "./activity": "./src/scan/activity.ts",
    "./balance": "./src/scan/balance.ts",
    "./chain": "./src/wallet/chain.ts",
    "./connection": "./src/wallet/connection.ts",
    "./consumerBuild": "./src/consumer/consumerBuild.ts",
    "./consumerFlows": "./src/consumer/consumerFlows.ts",
    "./consumerSubmit": "./src/consumer/consumerSubmit.ts",
    "./deposit": "./src/spend/deposit.ts",
    "./depositFlow": "./src/spend/depositFlow.ts",
    "./derive": "./src/login/derive.ts",
    "./device": "./src/wallet/device.ts",
    "./identity": "./src/login/identity.ts",
    "./keyCache": "./src/wallet/keyCache.ts",
    "./loginFlow": "./src/login/loginFlow.ts",
    "./loginGuard": "./src/login/loginGuard.ts",
    "./money": "./src/money.ts",
    "./refresh": "./src/scan/refresh.ts",
    "./relayerClient": "./src/wallet/relayerClient.ts",
    "./selfscan": "./src/scan/selfscan.ts",
    "./session": "./src/login/session.ts",
    "./spend": "./src/spend/spend.ts",
    "./spendFlow": "./src/spend/spendFlow.ts",
    "./stealthFunds": "./src/stealth/stealthFunds.ts",
    "./stealthKeys": "./src/stealth/stealthKeys.ts"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bongtu/core": "*",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
