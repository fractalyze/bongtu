{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  // Both destinations are copied from apps/wallet-web/vercel.json so the third
  // Vercel project deploys at all — but the `/indexer` rewrite MUST later point at a
  // PUBLIC-mode indexer instance: today's target is the institution-internal box,
  // and the consumer wallet's whole contract is that it only ever reads the public
  // endpoints (/events, /nullifiers, /head, /path, /names). Repointing it is an ops
  // task recorded on issue #13 (Needs the user / ops), not a code change.
  //
  // The `/circuits` rewrite carries this app's OWN CIRCUITS_VERSION path segment
  // ("00000000" is the src/config.ts placeholder pin): S7 uploads the consumer
  // proving assets to the blob store and bumps the pin + this path together.
  "rewrites": [
    {
      "source": "/indexer/:path*",
      "destination": "https://gpu-server.tailec11d1.ts.net:10000/:path*"
    },
    {
      "source": "/circuits/:path*",
      "destination": "https://hbttd0nloguhlykr.public.blob.vercel-storage.com/circuits/00000000/:path*"
    }
  ]
}
