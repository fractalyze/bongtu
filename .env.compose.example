# docker-compose knobs for the postgres + indexer stack (U-I3).
#   cp .env.compose.example .env.compose   # then edit; .env.compose is gitignored
#   docker compose --env-file .env.compose up --build
#
# NEVER put a funded/deployer key here — the indexer is read-only on-chain and
# opens no wallet. AUTHORITY_KEY below is the arbiter *bjj* private key (a scalar),
# not an EVM account key; set it only for an institution-internal arbiter indexer.

# --- Postgres (named volume pgdata; used to derive DATABASE_URL) --------------
# POSTGRES_PASSWORD must be URL-safe: compose builds DATABASE_URL by string
# interpolation (postgres://USER:PASSWORD@postgres:5432/DB) with no percent-
# encoding, so a password containing @ : / # ? = + would mis-parse the host/db
# and the indexer would fail to connect. Use only unreserved URL characters.
POSTGRES_USER=bongtu
POSTGRES_PASSWORD=bongtu
POSTGRES_DB=bongtu

# --- Indexer -----------------------------------------------------------------
# RPC endpoint. Default (host.docker.internal:8545) reaches a host-run anvil.
# For the live GIWA pool use: https://sepolia-rpc.giwa.io
RPC=http://host.docker.internal:8545

# Pool address. Leave empty to use deploy/addresses.<CHAIN_ID>.json baked into the
# image (91342 = the live GIWA pool). Set explicitly for a local/anvil deploy.
POOL=

# Chain id for the addresses-file fallback (91342 = GIWA Sepolia).
CHAIN_ID=91342

# First block to replay. Set near the pool's deploy block on a long-lived chain
# to avoid a from-genesis scan.
START_BLOCK=0

# Incremental tail-poll interval in ms (0 = ingest once, no polling).
POLL_MS=5000

# Arbiter bjj PRIVATE key (scalar, decimal or 0x-hex). Set => ARBITER MODE
# (decrypts every op's envelope; serves /notes + /history + within-batch /path).
# Leave empty for a public indexer.
AUTHORITY_KEY=

# Host port to publish the indexer API on (container always listens on 8600).
INDEXER_PORT=8600
