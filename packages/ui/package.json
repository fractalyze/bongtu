{
  "name": "@bongtu/ui",
  "version": "0.0.0",
  "description": "bongtu shared UI — the error-surface components both apps render (toast host = events, banner = state, Copy details for the bug class) with the headless queue/dedup/timing logic split out so it gates under node:test without a DOM. Styling is classname-based on the apps' shared Tailwind tokens; each app compiles its own CSS.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "exports": {
    "./toastQueue": "./src/toastQueue.ts",
    "./clipboard": "./src/clipboard.ts",
    "./Toast": "./src/Toast.tsx",
    "./Banner": "./src/Banner.tsx",
    "./actionMachine": "./src/actionMachine.ts",
    "./assets": "./src/assets.ts",
    "./faucet": "./src/faucet.ts",
    "./keyCache": "./src/keyCache.ts",
    "./lockIntro": "./src/lockIntro.ts",
    "./loginPending": "./src/loginPending.ts",
    "./prove": "./src/prove.ts",
    "./toasts": "./src/toasts.ts",
    "./wagmi": "./src/wagmi.ts",
    "./walletBrand": "./src/walletBrand.ts"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bongtu/client": "*",
    "@bongtu/client-evm": "*",
    "@bongtu/core": "*",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "ffjavascript": "^0.3.0",
    "snarkjs": "^0.7.4",
    "viem": "^2.55.10",
    "wagmi": "^2.19.5"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
